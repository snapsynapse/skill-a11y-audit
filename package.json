{
  "name": "skill-a11y-audit",
  "version": "2.7.0",
  "description": "Open accessibility regression evidence for large web estates, with template-aware sampling and legacy-friendly CI baselines.",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "audit",
    "accessibility-regression",
    "accessibility-baseline",
    "ci",
    "agent-skill",
    "claude-code",
    "puppeteer",
    "web-accessibility",
    "wcag-2.1",
    "compliance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snapsynapse/skill-a11y-audit.git"
  },
  "author": "Snap Synapse LLC <https://snapsynapse.com/>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:search:production": "node scripts/check-production-search.mjs",
    "discover": "node a11y-audit/scripts/discover.js",
    "scan": "node a11y-audit/scripts/scan.js",
    "report": "node a11y-audit/scripts/report.js",
    "eval": "node a11y-audit/evals/run-evals.js",
    "eval:browser": "node a11y-audit/evals/run-browser-eval.js",
    "validate": "node a11y-audit/evals/run-evals.js --validate"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
