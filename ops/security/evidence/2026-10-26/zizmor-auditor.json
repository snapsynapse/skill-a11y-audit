          "feature": "name: Run a11y scan\n      shell: bash\n      env:\n        SITEMAP: ${{ inputs.sitemap }}\n        SITEMAP_FIND: ${{ inputs.sitemap-find }}\n        SITEMAP_REPLACE: ${{ inputs.sitemap-replace }}\n        SITEMAP_EXCLUDE: ${{ inputs.sitemap-exclude }}\n        URLS: ${{ inputs.urls }}\n        DISCOVER_URL: ${{ inputs.discover-url }}\n        DISCOVER_OUTPUT: ${{ inputs.discover-output }}\n        SURFACE_MAP: ${{ inputs.surface-map }}\n        CHANGED_FILES: ${{ inputs.changed-files }}\n        CHANGED_BASE: ${{ inputs.changed-base }}\n        SELECTION_OUTPUT: ${{ inputs.selection-output }}\n        FAIL_ON: ${{ inputs.fail-on }}\n        STORAGE_STATE: ${{ inputs.storage-state }}\n        AUTH_TARGETS: ${{ inputs.auth-targets }}\n        BASELINE: ${{ inputs.baseline }}\n        OUTPUT: ${{ inputs.output }}\n        SUMMARY: ${{ inputs.summary }}\n        INSTALL_TIMEOUT_MS: ${{ inputs.install-timeout-ms }}\n      run: |\n        ARGS=()\n        DISCOVER_PLAN=\"$DISCOVER_OUTPUT\"\n        if [ -n \"$SURFACE_MAP\" ] && [ -s \"$SELECTION_OUTPUT\" ] && { [ -n \"$CHANGED_FILES\" ] || [ -n \"$CHANGED_BASE\" ]; }; then\n          DISCOVER_PLAN=\"$SELECTION_OUTPUT\"\n        fi\n        [ -n \"$SITEMAP\" ]         && ARGS+=(--sitemap \"$SITEMAP\")\n        [ -n \"$SITEMAP_FIND\" ]    && ARGS+=(--sitemap-find \"$SITEMAP_FIND\")\n        [ -n \"$SITEMAP_REPLACE\" ] && ARGS+=(--sitemap-replace \"$SITEMAP_REPLACE\")\n        [ -n \"$SITEMAP_EXCLUDE\" ] && ARGS+=(--sitemap-exclude \"$SITEMAP_EXCLUDE\")\n        [ -n \"$URLS\" ]            && ARGS+=(--urls \"$URLS\")\n        [ -n \"$DISCOVER_URL\" ]    && ARGS+=(--discover \"$DISCOVER_PLAN\")\n        [ -n \"$FAIL_ON\" ]         && ARGS+=(--fail-on \"$FAIL_ON\")\n        [ -n \"$BASELINE\" ]        && ARGS+=(--baseline \"$BASELINE\")\n        [ \"$SUMMARY\" = \"true\" ]   && ARGS+=(--summary)\n        [ -n \"$INSTALL_TIMEOUT_MS\" ] && ARGS+=(--install-timeout-ms \"$INSTALL_TIMEOUT_MS\")\n        [ -n \"$STORAGE_STATE\" ] && ARGS+=(--storage-state \"$STORAGE_STATE\")\n        [ -n \"$AUTH_TARGETS\" ] && ARGS+=(--auth-targets \"$AUTH_TARGETS\")\n        ARGS+=(--output \"$OUTPUT\")\n        node \"${{ github.action_path }}/../../../a11y-audit/scripts/scan.js\" \"${ARGS[@]}\"",
